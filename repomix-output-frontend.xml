                                className={`px-6 py-4 font-medium text-sm whitespace-nowrap border-b-2 transition-colors ${activeTab === 'security'
                                    ? 'border-primary text-primary'
                                    : 'border-transparent text-gray-600 hover:text-base-content'
                                    }`}
                            >
                                Security
                            </button>
                            {profile?.role === 'tutor' && (
                                <button
